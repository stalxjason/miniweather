      },
      {
        "pagePath": "pages/tide/tide",
        "text": "潮汐",
        "iconPath": "images/icon-tide.png",
        "selectedIconPath": "images/icon-tide-active.png"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于获取当地天气和潮汐数据"

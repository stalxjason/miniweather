/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #F0F4FF;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #1677FF;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* 城市选择器 */
.city-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  position: relative;
}

.city-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-right: 8rpx;
}

.city-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #999;
}

/* Flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 文字样式 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-muted { color: #999; }
.text-primary { color: #1677FF; }
.text-danger { color: #FF4D4F; }
.text-success { color: #52C41A; }
.text-warning { color: #FAAD14; }

.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-xxl { font-size: 56rpx; }

.font-bold { font-weight: 700; }

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
  border: 6rpx solid #E6F0FF;
  border-top-color: #1677FF;
  border-radius: 50%;
  box-sizing: border-box;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 通用状态卡片：错误 / 加载失败（含重试按钮），全局复用 */
.state-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.state-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}
.state-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 32rpx;
  max-width: 520rpx;
}
.retry-btn {
  background: #1677FF;
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 16rpx 56rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.retry-btn:active {
  background: #0958D9;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 20rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-blue {
  background: #E6F4FF;
  color: #1677FF;
}

.tag-orange {
  background: #FFF7E6;
  color: #FA8C16;
}

/* 按钮 */
.btn-primary {
  background: #1677FF;
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  display: inline-block;
}

.btn-primary:active {
  background: #0958D9;
}

<view class="privacy-mask" wx:if="{{show}}">
  <view class="privacy-popup">
    <view class="privacy-title">隐私授权提醒</view>
    <view class="privacy-body">
      为向你提供当地天气与潮汐服务，我们需要获取你的<text class="privacy-em">位置信息</text>。
      请先阅读并同意<text class="privacy-link" bindtap="openContract">《隐私保护指引》</text>。
    </view>
    <view class="privacy-actions">
      <view class="privacy-btn privacy-btn-cancel" bindtap="disagree">拒绝</view>
      <view class="privacy-btn privacy-btn-ok" bindtap="agree">同意并使用</view>
    </view>
  </view>
</view>

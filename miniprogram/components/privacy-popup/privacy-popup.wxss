.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.privacy-popup {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 28rpx;
  box-sizing: border-box;
}
.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 20rpx;
}
.privacy-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: #555;
  margin-bottom: 32rpx;
}
.privacy-em {
  color: #1677FF;
}
.privacy-link {
  color: #1677FF;
  text-decoration: underline;
}
.privacy-actions {
  display: flex;
  gap: 20rpx;
}
.privacy-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.privacy-btn-cancel {
  background: #f2f3f5;
  color: #555;
}
.privacy-btn-ok {
  background: #1677FF;
  color: #fff;
}

/* pages/index/index.wxss - 全屏动态天气 */

/* ===== 内容层：位于固定动效之上 ===== */
.content-layer {
  position: relative;
  z-index: 1;
}

/* ===== 全屏天气动效层（固定背景） ===== */
.weather-effect {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

/* 各天气天空渐变 */
.effect-sun {
  background: linear-gradient(165deg, #2E86DE 0%, #5DADE2 45%, #AED6F1 100%);
}
.effect-cloud {
  background: linear-gradient(165deg, #5D6D7E 0%, #85929E 50%, #AEB6BF 100%);
}
.effect-rain {
  background: linear-gradient(165deg, #34495E 0%, #4B6584 50%, #5D6D7E 100%);
}
.effect-thunder {
  background: linear-gradient(165deg, #1B2631 0%, #212F3D 50%, #283747 100%);
}
.effect-snow {
  background: linear-gradient(165deg, #7F8C9B 0%, #AAB7C4 50%, #DDE6EE 100%);
}
.effect-fog {
  background: linear-gradient(165deg, #909497 0%, #B2BABB 50%, #CCD1D1 100%);
}

/* 雨滴下落（含雷电复用） */
@keyframes rain-fall {
  0% { transform: translateY(-80rpx); opacity: 0; }
  10% { opacity: 0.85; }
  90% { opacity: 0.85; }
  100% { transform: translateY(2000rpx); opacity: 0; }
}
.effect-rain .particle,
.effect-thunder .particle {
  position: absolute;
  width: 2rpx;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.75));
  border-radius: 2rpx;
  animation: rain-fall linear infinite;
}

/* 雪花飘落 */
@keyframes snow-fall {
  0% { transform: translateY(-80rpx) translateX(0); opacity: 0; }
  10% { opacity: 0.95; }
  100% { transform: translateY(2000rpx) translateX(60rpx); opacity: 0; }
}
.effect-snow .particle {
  position: absolute;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.6);
  animation: snow-fall linear infinite;
}

/* 云层飘动 */
@keyframes cloud-drift {
  0% { transform: translateX(-200rpx); }
  100% { transform: translateX(950rpx); }
}
.effect-cloud .cloud,
.effect-fog .cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  filter: blur(16rpx);
  animation: cloud-drift linear infinite;
}
.effect-fog .cloud {
  background: rgba(255, 255, 255, 0.42);
  filter: blur(30rpx);
}

/* 太阳 / 光晕 */
@keyframes sun-pulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.06); opacity: 1; }
}
@keyframes sun-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.effect-sun .sun {
  position: absolute;
  top: 70rpx;
  right: 70rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle at 32% 30%, #FFF6C0, #FFD93B);
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(255, 217, 59, 0.7), 0 0 130rpx rgba(255, 217, 59, 0.4);
  animation: sun-pulse 3s ease-in-out infinite;
}
.effect-sun .sun-ray {
  position: absolute;
  top: 56rpx;
  right: 56rpx;
  width: 148rpx;
  height: 148rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  animation: sun-rotate 8s linear infinite;
}
.effect-sun .sun-ray:nth-child(2) { animation-duration: 10s; animation-delay: -2s; border-width: 6rpx; }
.effect-sun .sun-ray:nth-child(3) { animation-duration: 12s; animation-delay: -5s; border-width: 3rpx; }
.effect-sun .sun-ray:nth-child(4) { animation-duration: 14s; animation-delay: -8s; border-width: 5rpx; }

/* 雷电闪烁（全屏） */
@keyframes thunder-flash {
  0%, 90%, 100% { opacity: 0; }
  91% { opacity: 0.28; }
  92% { opacity: 0; }
  93% { opacity: 0.4; }
  94% { opacity: 0; }
  95% { opacity: 0.22; }
  96% { opacity: 0; }
}
.effect-thunder.weather-effect::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.18);
  animation: thunder-flash 5s infinite;
  pointer-events: none;
}

/* ===== Hero 顶部天气信息（透明，浮于天空之上） ===== */
.hero-section {
  padding: 40rpx 40rpx 30rpx;
  color: #FFFFFF;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.28);
}
.hero-dark {
  color: #1A1A1A;
  text-shadow: 0 2rpx 14rpx rgba(255, 255, 255, 0.45);
}
.hero-dark .city-arrow {
  border-top-color: rgba(0, 0, 0, 0.45);
}

.city-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
}

.city-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.city-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(255, 255, 255, 0.7);
}

.now-weather {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  position: relative;
  z-index: 1;
}

.now-temp {
  font-size: 110rpx;
  font-weight: 200;
  line-height: 1;
}

.now-info {
  flex: 1;
  margin-left: 30rpx;
}

.now-text {
  font-size: 38rpx;
  font-weight: 500;
  display: block;
}

.now-feels {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 6rpx;
  display: block;
}

.now-icon {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.now-detail {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  position: relative;
  z-index: 1;
}

.detail-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.detail-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 玻璃卡片（毛玻璃叠在天空之上） ===== */
.card {
  background: rgba(255, 255, 255, 0.82);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 7天预报 */
.forecast-list {
  padding: 10rpx 0;
}

.forecast-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-date {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.forecast-weekday {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.forecast-day {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.forecast-icon {
  width: 64rpx;
  height: 64rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.forecast-text {
  flex: 1;
  font-size: 30rpx;
  color: #555;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.forecast-meta {
  width: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
}

.forecast-temp {
  font-size: 30rpx;
  font-weight: 500;
  white-space: nowrap;
}

.forecast-wind {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 生活指数 */
.indices-grid {
  display: flex;
  flex-wrap: wrap;
}

.index-item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}

.index-name {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.index-value {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1677FF;
}

/* 潮汐入口 */
.tide-entry {
  cursor: pointer;
}

.tide-entry:active {
  background: rgba(248, 248, 248, 0.9);
}

.tide-entry-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.tide-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

/* 更新时间 */
.update-info {
  padding: 30rpx 0;
  text-align: center;
}

/* ===== 实时天气可点击卡片 ===== */
.now-card {
  position: relative;
  z-index: 1;
  cursor: pointer;
  border-radius: 28rpx;
  transition: opacity 0.15s, background 0.15s;
}
.now-card:active {
  opacity: 0.88;
  background: rgba(255, 255, 255, 0.08);
}
.now-card-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 18rpx;
  animation: hint-bounce 1.8s ease-in-out infinite;
}
@keyframes hint-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6rpx); }
}

/* ===== 全天逐时天气底部弹层 ===== */
.hourly-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  animation: mask-fade 0.25s ease;
}
@keyframes mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.hourly-panel {
  width: 100%;
  max-height: 78vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: sheet-up 0.3s cubic-bezier(0.18, 0.89, 0.32, 1);
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.hourly-grabber {
  width: 72rpx;
  height: 8rpx;
  background: #D9D9D9;
  border-radius: 4rpx;
  margin: 8rpx auto 16rpx;
}

.hourly-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.hourly-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.hourly-sub {
  margin-top: 4rpx;
}
.hourly-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
  line-height: 1;
}

.hourly-body {
  flex: 1;
  overflow-y: auto;
  margin-top: 8rpx;
  -webkit-overflow-scrolling: touch;
}

.hourly-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.hourly-row-now {
  background: #FFF7E6;
  margin: 0 -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  border-radius: 12rpx;
}

.hr-time {
  width: 110rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.hr-time-now {
  color: #FA8C16;
}
.hr-icon {
  width: 70rpx;
  height: 70rpx;
  text-align: center;
  flex-shrink: 0;
}
.hr-temp {
  width: 110rpx;
  font-size: 32rpx;
  color: #222;
  font-weight: 600;
  text-align: center;
}
.hr-text {
  flex: 1;
  font-size: 28rpx;
  color: #555;
}
.hr-pop {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  color: #1677FF;
}
.hr-wind {
  width: 120rpx;
  text-align: right;
}

.hourly-loading {
  padding: 80rpx 0;
}

/* ===== 分钟级降水卡片 ===== */
.rain-summary {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 18rpx;
}
.rain-bars {
  display: flex;
  align-items: flex-end;
  height: 110rpx;
}
.rain-bar {
  flex: 1;
  min-width: 2rpx;
  margin: 0 1rpx;
  background: linear-gradient(to top, #1677FF, #69B1FF);
  border-radius: 2rpx 2rpx 0 0;
  transition: height 0.3s ease;
}
.rain-bar-snow {
  background: linear-gradient(to top, #90A4AE, #ECEFF1);
}
.rain-tip {
  display: block;
  font-size: 26rpx;
}

/* ===== 空气质量卡片 ===== */
.air-row {
  display: flex;
  align-items: center;
}
.air-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}
.air-aqi {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}
.air-cat {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.air-detail {
  flex: 1;
}
.air-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.air-item:last-child {
  border-bottom: none;
}
.air-label {
  font-size: 26rpx;
  color: #999;
}
.air-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* ===== 台风板块 ===== */
.typhoon-card {
  padding-bottom: 20rpx;
}
.typhoon-loading,
.typhoon-empty {
  padding: 24rpx 0;
  text-align: center;
}
.typhoon-hint {
  padding: 16rpx 4rpx 4rpx;
  line-height: 1.5;
}
.typhoon-grade-hist {
  background: #BFBFBF;
}
.typhoon-item {
  border-top: 1rpx solid #F0F0F0;
  padding-top: 20rpx;
  margin-top: 16rpx;
}
.typhoon-item:first-child {
  border-top: none;
  margin-top: 8rpx;
  padding-top: 8rpx;
}
.typhoon-brief {
  cursor: pointer;
  border-radius: 16rpx;
  padding: 16rpx;
  background: rgba(255, 77, 79, 0.05);
}
.typhoon-brief:active {
  background: rgba(255, 77, 79, 0.12);
}
.typhoon-brief-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.typhoon-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.typhoon-grade {
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #999;
}
.typhoon-brief-sub {
  margin-top: 10rpx;
}
.typhoon-trend {
  display: block;
  margin-top: 8rpx;
  color: #555;
}

/* 7天预报温度色阶（独立于错误红/主色蓝，语义更清晰） */
.temp-max {
  color: #FF7A45;
  font-weight: 500;
}
.temp-min {
  color: #1677FF;
  font-weight: 500;
}
.typhoon-expand {
  display: block;
  text-align: right;
  margin-top: 6rpx;
}

/* 强度等级配色（grade-{NMC代码}） */
.grade-TD { background: #52C41A !important; color: #fff; }
.grade-TS { background: #13C2C2 !important; color: #fff; }
.grade-STS { background: #1890FF !important; color: #fff; }
.grade-TY { background: #FA8C16 !important; color: #fff; }
.grade-STY { background: #F5222D !important; color: #fff; }
.grade-SuperTY { background: #722ED1 !important; color: #fff; }

/* 详情 */
.typhoon-detail {
  margin-top: 16rpx;
}
.typhoon-map {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EEE;
}
.typhoon-map-legend {
  margin: 10rpx 0 16rpx;
}
.typhoon-detail-grid {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 12rpx;
}
.typhoon-detail-row {
  width: 50%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.typhoon-detail-row-full {
  width: 100%;
}
.detail-label {
  font-size: 24rpx;
  color: #999;
}
.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}
.typhoon-path-title {
  margin: 14rpx 0 8rpx;
}
.typhoon-path-list {
  border-top: 1rpx solid #F0F0F0;
}
.typhoon-path-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 24rpx;
  color: #555;
}
.tp-time { width: 150rpx; color: #333; }
.tp-grade {
  width: 130rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  text-align: center;
  color: #fff;
}
.tp-pos { flex: 1; }
.tp-wind { width: 220rpx; text-align: right; color: #888; }

/* ===== 天文信息卡片 ===== */
.astro-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.astro-item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.astro-item-full {
  width: 100%;
}
.astro-icon {
  font-size: 36rpx;
  display: block;
}
.astro-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin: 4rpx 0;
}
.astro-value {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

/* pages/index/index.wxss - 全屏动态天气 */

/* ===== 内容层：位于固定动效之上 ===== */
.content-layer {
  position: relative;
  z-index: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

/* ===== 全屏自然天气天空氛围层（固定背景） ===== */
.weather-effect {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  transition: background 0.8s ease-in-out;
}

/* 顶部微弱自然大气天光反射 */
.weather-effect::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 480rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 75%);
  pointer-events: none;
}

/* 优雅通透的各天气天空微渐变（晴/云/雨/雷/雪/雾） */
.effect-sun {
  background: linear-gradient(180deg, #3A8AE8 0%, #68A7F4 32%, #C4DDFA 65%, #F0F4FA 100%);
}

.effect-cloud {
  background: linear-gradient(180deg, #58718E 0%, #7E97B2 32%, #C9D8E6 65%, #F2F5F8 100%);
}

.effect-rain {
  background: linear-gradient(180deg, #475F78 0%, #69839C 32%, #BCCCDA 65%, #EFF3F6 100%);
}

.effect-thunder {
  background: linear-gradient(180deg, #304052 0%, #4D6277 32%, #A8B8C8 65%, #ECEFF4 100%);
}

.effect-snow {
  background: linear-gradient(180deg, #6C8198 0%, #96A8BB 32%, #DCE5EE 65%, #F5F7FA 100%);
}

.effect-fog {
  background: linear-gradient(180deg, #7C8690 0%, #9EA7B0 32%, #D9DFE4 65%, #F4F6F8 100%);
}

/* ===== Hero：大字温度版式（参考墨迹风格） ===== */
.hero-section {
  padding: 30rpx 40rpx 36rpx;
  color: #FFFFFF;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.28);
}
.hero-dark {
  color: #1A1A1A;
  text-shadow: none;
}
.hero-dark .city-arrow {
  border-top-color: rgba(0, 0, 0, 0.45);
}

.city-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}
.city-pin {
  font-size: 30rpx;
  margin-right: 6rpx;
}
.city-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 8rpx;
}
.city-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(255, 255, 255, 0.7);
}

/* 预警徽标（左上，橙/黄/红底白字） */
.hero-warning-row {
  position: relative;
  z-index: 1;
  min-height: 56rpx;
  margin: 6rpx 0;
}
.hero-warning {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-shadow: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
.hero-warning-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 大字温度（细体，居中） */
.hero-temp-row {
  text-align: center;
  position: relative;
  z-index: 1;
  margin: -20rpx 0 0;
}
.hero-temp {
  font-size: 190rpx;
  font-weight: 100;
  line-height: 1.15;
  letter-spacing: -4rpx;
}
.hero-temp-unit {
  font-size: 90rpx;
  font-weight: 200;
  vertical-align: 60rpx;
  letter-spacing: 0;
}

/* 天气文字 | AQI 徽标 */
.hero-cond {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
}
.hero-cond-text {
  font-size: 32rpx;
  font-weight: 500;
}
.hero-cond-sep {
  margin: 0 18rpx;
  opacity: 0.6;
  font-size: 28rpx;
}
.hero-aqi {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-shadow: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 关键指标行 */
.hero-metrics {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 22rpx;
  font-size: 26rpx;
  opacity: 0.95;
  position: relative;
  z-index: 1;
}
.hero-metric-sep {
  margin: 0 16rpx;
  opacity: 0.55;
}

/* 快讯卡：降水 / 台风 */
.notice-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  position: relative;
  z-index: 1;
}
.notice-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  text-shadow: none;
  transition: background 0.15s;
}
.notice-card:active {
  background: rgba(255, 255, 255, 0.35);
}
.hero-dark .notice-card {
  background: rgba(0, 0, 0, 0.05);
}
.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: inherit;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.notice-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

/* 今明两条预报胶囊 */
.today-strip {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.20);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  position: relative;
  z-index: 1;
  text-shadow: none;
}
.hero-dark .today-strip {
  background: rgba(0, 0, 0, 0.05);
  border-color: rgba(0, 0, 0, 0.08);
}
.today-cell {
  flex: 1;
  min-width: 0;
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.today-label {
  font-size: 26rpx;
  font-weight: 700;
  color: inherit;
}
.today-temp {
  font-size: 26rpx;
  font-weight: 600;
  color: inherit;
}
.today-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.today-text {
  font-size: 22rpx;
  opacity: 0.90;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.today-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}
.today-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.32);
  margin: 4rpx 22rpx;
}
.hero-dark .today-divider {
  background: rgba(0, 0, 0, 0.10);
}

/* ===== 统一玻璃卡片规范 ===== */
.card {
  background: rgba(255, 255, 255, 0.90);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin: 16rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.80);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card .card-title::before {
  display: none;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F1F;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}

.title-with-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.title-icon {
  font-size: 28rpx;
  line-height: 1;
}

.title-sub {
  font-size: 22rpx;
  color: #8C8C8C;
  font-weight: 400;
  letter-spacing: 0;
}

/* ===== 图表卡片（24小时 / 7天）===== */
.chart-card {
  position: relative;
  overflow: hidden;
}

.sun-times {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}
.sun-time-sunset {
  margin-left: 20rpx;
}

.chart-scroll {
  width: 100%;
  margin-top: 6rpx;
}
/* webview 滚动条隐藏（滚动跟随手指的原生实现） */
.chart-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
.chart-inner {
  position: relative;
}

/* 离屏绘制缓冲：移出可视区、不参与布局与滚动，仅用于导出图片 */
.canvas-buffer {
  position: absolute;
  left: -3000px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

/* 曲线图（离屏 canvas 导出的临时图片） */
/* 24小时逐时预报单列等宽布局 (58px) */
.hourly-row {
  display: flex;
}

.hcol {
  width: 58px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 1. 时间轴 */
.hourly-times {
  margin-bottom: 6px;
  margin-top: 4px;
}
.hcol-time {
  font-size: 11px;
  color: #8C8C8C;
  font-weight: 500;
}
.hcol-time-now {
  color: #1677FF;
  font-weight: 700;
}
.hcol-time-tmr {
  color: #FA8C16;
  font-weight: 600;
}

/* 2. 天气图标 */
.hourly-icons {
  margin-bottom: 2px;
}
.hcol-icon {
  width: 28px;
  height: 28px;
}

/* 3. 温度平滑曲线（离屏 canvas 导出的临时图片） */
.hourly-curve-img {
  display: block;
}

/* 4. 天气文字 */
.hourly-texts {
  margin-top: 4px;
}
.hcol-text {
  font-size: 11px;
  color: #595959;
  max-width: 54px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

/* 5. 风级微型胶囊 */
.hourly-winds {
  margin-top: 6px;
  padding-bottom: 4px;
}
.wind-capsule {
  background: #F4F6F9;
  border-radius: 10px;
  padding: 2px 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.wind-text {
  font-size: 10px;
  color: #8C8C8C;
  white-space: nowrap;
}

/* 7天：整列高亮 + 双曲线 + 底部夜间天气 */
.daily-wrap {
  position: relative;
  margin-top: 6rpx;
}
.daily-today-bg {
  position: absolute;
  top: -6rpx;
  bottom: -6rpx;
  background: rgba(22, 119, 255, 0.07);
  border-radius: 16rpx;
  z-index: 0;
  transition: all 0.25s ease;
}
.daily-head {
  display: flex;
  position: relative;
  z-index: 1;
}
.fc-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0 2rpx;
}
.fc-week {
  font-size: 26rpx;
  font-weight: 600;
  color: #262626;
}
.fc-week-today {
  color: #1677FF;
}
.fc-date {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-top: 2rpx;
}
.fc-text {
  font-size: 22rpx;
  color: #595959;
  margin-top: 6rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fc-icon {
  width: 46rpx;
  height: 46rpx;
  margin-top: 6rpx;
}
.daily-canvas {
  display: block;
  position: relative;
  z-index: 1;
  margin: 6rpx auto;
}

.daily-foot {
  display: flex;
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
}
.fc-icon-night {
  width: 44rpx;
  height: 44rpx;
}
.fc-text-night {
  font-size: 21rpx;
  color: #595959;
  margin-top: 4rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fc-wind {
  font-size: 19rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
  white-space: nowrap;
}

/* ===== 生活指数（现代化小组件网格） ===== */
.indices-card {
  padding-bottom: 24rpx;
}

.indices-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 10rpx;
}

.index-tile {
  background: #F7F9FC;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.index-tile:active {
  background: #EBF2FA;
  transform: scale(0.97);
}

.index-tile-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.index-tile-icon {
  font-size: 26rpx;
  line-height: 1;
}

.index-tile-name {
  font-size: 21rpx;
  color: #8C8C8C;
  white-space: nowrap;
}

.index-tile-value {
  font-size: 25rpx;
  font-weight: 600;
  color: #1677FF;
  line-height: 1.2;
  white-space: nowrap;
}

/* ===== 潮汐海洋速报入口 ===== */
.tide-entry {
  background: linear-gradient(135deg, rgba(230, 244, 255, 0.92) 0%, rgba(240, 248, 255, 0.95) 100%);
  border: 1rpx solid rgba(22, 119, 255, 0.18);
  cursor: pointer;
  transition: all 0.2s ease;
}

.tide-entry:active {
  background: rgba(220, 240, 255, 0.95);
  transform: scale(0.98);
}

.tide-entry-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tide-entry-main {
  flex: 1;
  min-width: 0;
}

.tide-entry-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tide-entry-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}

.tide-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0D4E8C;
}

.tide-entry-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #1677FF;
  background: #E6F4FF;
  border: 1rpx solid rgba(22, 119, 255, 0.25);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tide-entry-desc {
  font-size: 22rpx;
  color: #595959;
  margin-top: 6rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tide-entry-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #1677FF;
  color: #FFFFFF;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(22, 119, 255, 0.25);
}

.tide-entry-btn-text {
  font-size: 22rpx;
  font-weight: 500;
}

.tide-entry-arrow {
  font-size: 24rpx;
  line-height: 1;
}

/* 更新时间 */
.update-info {
  padding: 30rpx 0;
  text-align: center;
}

/* ===== 分钟级降水卡片 ===== */
.rain-card {
  position: relative;
}

.rain-summary {
  display: block;
  font-size: 28rpx;
  color: #262626;
  font-weight: 500;
  margin-bottom: 14rpx;
}

.rain-bars-wrap {
  margin-top: 10rpx;
}

.rain-bars {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.rain-bar {
  flex: 1;
  min-width: 2rpx;
  margin: 0 1rpx;
  background: linear-gradient(to top, #1677FF, #69B1FF);
  border-radius: 2rpx 2rpx 0 0;
  transition: height 0.3s ease;
}

.rain-bar-snow {
  background: linear-gradient(to top, #90A4AE, #ECEFF1);
}

.rain-time-axis {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.rain-empty {
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
}

/* ===== 空气质量卡片 ===== */
.air-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.air-badge {
  width: 156rpx;
  height: 156rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1);
}

.air-aqi {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
}

.air-cat {
  font-size: 24rpx;
  margin-top: 8rpx;
  font-weight: 600;
}

.air-detail {
  flex: 1;
  min-width: 0;
}

.air-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.air-item:last-child {
  border-bottom: none;
}

.air-label {
  font-size: 24rpx;
  color: #8C8C8C;
}

.air-value {
  font-size: 26rpx;
  color: #262626;
  font-weight: 600;
}

.air-unit {
  font-size: 20rpx;
  color: #8C8C8C;
  font-weight: 400;
  margin-left: 2rpx;
}

/* ===== 台风板块（全新设计） ===== */
.typhoon-card {
  padding-bottom: 24rpx;
}

.typhoon-header-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.typhoon-status-pill {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.pill-active {
  background: #FFF1F0;
  color: #F5222D;
  border: 1rpx solid #FFA39E;
}

.pill-quiet {
  background: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.typhoon-arrow {
  font-size: 24rpx;
  color: #8C8C8C;
}

.typhoon-loading {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8C8C8C;
}

/* 场景一：无活跃台风安心看板 */
.typhoon-peace-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 10rpx 8rpx;
  text-align: center;
}

.peace-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F6FFED;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(82, 196, 26, 0.25);
}

.peace-icon {
  font-size: 42rpx;
}

.peace-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #262626;
  margin-bottom: 6rpx;
}

.peace-sub {
  font-size: 22rpx;
  color: #8C8C8C;
  line-height: 1.4;
}

.history-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #F7F9FC;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  margin-top: 20rpx;
  transition: all 0.2s;
}

.history-toggle-btn:active {
  background: #EBF2FA;
}

.history-btn-text {
  font-size: 22rpx;
  color: #595959;
  font-weight: 500;
}

.history-btn-arrow {
  font-size: 22rpx;
  color: #8C8C8C;
}

/* 场景二：台风列表与详情卡 */
.typhoon-list-wrap {
  margin-top: 14rpx;
}

.typhoon-card-item {
  border-radius: 18rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  overflow: hidden;
  background: #F8FAFD;
  transition: all 0.2s;
}

.item-active {
  background: #FFFDF9;
  border-color: rgba(250, 140, 22, 0.35);
  box-shadow: 0 4rpx 14rpx rgba(250, 140, 22, 0.08);
}

.item-hist {
  background: #FAFAFA;
  border-color: rgba(0, 0, 0, 0.05);
}

.typhoon-item-header {
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  cursor: pointer;
}

.t-item-main {
  flex: 1;
  min-width: 0;
}

.t-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.t-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F1F;
}

.t-en-name {
  font-size: 22rpx;
  color: #8C8C8C;
}

.t-num-tag {
  font-size: 20rpx;
  color: #1677FF;
  background: #E6F4FF;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.t-trend-text {
  font-size: 22rpx;
  color: #D46B08;
  margin-top: 6rpx;
  display: block;
}

.t-hist-text {
  font-size: 21rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
  display: block;
}

.t-item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.typhoon-grade-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 3rpx 14rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
}

.grade-hist {
  background: #BFBFBF;
  color: #FFFFFF;
}

.t-expand-hint {
  font-size: 20rpx;
  color: #8C8C8C;
}

/* 强度等级配色（grade-{NMC代码}） */
.grade-TD { background: #52C41A !important; color: #fff; }
.grade-TS { background: #13C2C2 !important; color: #fff; }
.grade-STS { background: #1890FF !important; color: #fff; }
.grade-TY { background: #FA8C16 !important; color: #fff; }
.grade-STY { background: #F5222D !important; color: #fff; }
.grade-SuperTY { background: #722ED1 !important; color: #fff; }

/* 4 宫格核心参数仪表盘 */
.typhoon-dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  padding: 14rpx 18rpx 10rpx;
}

.t-dash-cell {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.dash-label {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-bottom: 4rpx;
}

.dash-value {
  font-size: 25rpx;
  font-weight: 700;
  color: #262626;
}

.highlight-wind {
  color: #F5222D;
}

.dash-unit {
  font-size: 20rpx;
  color: #8C8C8C;
  font-weight: 400;
}

/* 风圈说明条 */
.radii-info-bar {
  margin: 0 18rpx 12rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE7BA;
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.radii-tag {
  font-size: 19rpx;
  font-weight: 700;
  background: #FA8C16;
  color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.radii-content {
  font-size: 21rpx;
  color: #D46B08;
}

/* 地图容器与图例 */
.t-map-container {
  margin: 0 18rpx 14rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.typhoon-map {
  width: 100%;
  height: 380rpx;
}

.t-map-legend {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 16rpx;
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #F0F0F0;
  font-size: 20rpx;
  color: #595959;
}

.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.line-solid {
  background: #FF4D4F;
}

.line-dashed {
  background: #FFA940;
  border-top: 2rpx dashed #FFA940;
  height: 0;
}

/* 近期轨迹时间轴 */
.t-timeline-section {
  padding: 0 18rpx 14rpx;
}

.t-timeline-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #595959;
  margin-bottom: 8rpx;
}

.t-timeline-list {
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  padding: 8rpx 14rpx;
}

.t-timeline-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 21rpx;
}

.t-timeline-item:last-child {
  border-bottom: none;
}

.timeline-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1677FF;
  margin-right: 8rpx;
}

.timeline-time {
  color: #262626;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.timeline-grade {
  font-size: 19rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #fff;
}

.timeline-pos {
  color: #8C8C8C;
}

.timeline-meta {
  color: #595959;
  font-weight: 600;
}

/* ===== 天文信息卡片（双面板：太阳 | 月亮） ===== */
.astro-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.astro-panel {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.astro-panel-sun {
  background: linear-gradient(160deg, #FFF8EC 0%, #FFE9C2 100%);
  border: 1rpx solid rgba(255, 186, 74, 0.25);
  box-shadow: 0 4rpx 14rpx rgba(255, 170, 60, 0.08);
}
.astro-panel-moon {
  background: linear-gradient(160deg, #F0F4FA 0%, #DCE4F2 100%);
  border: 1rpx solid rgba(130, 155, 200, 0.22);
  box-shadow: 0 4rpx 14rpx rgba(80, 100, 150, 0.08);
}
.astro-panel-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.astro-panel-icon {
  font-size: 44rpx;
  line-height: 1;
}
.astro-panel-meta { display: flex; flex-direction: column; }
.astro-panel-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.astro-panel-sub {
  font-size: 20rpx;
  color: #6b6357;
  margin-top: 2rpx;
}
.astro-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}
.astro-line-icon { font-size: 28rpx; line-height: 1; }
.astro-line-text {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.astro-line-label {
  font-size: 22rpx;
  color: #8a8275;
}
.astro-line-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2a2520;
  font-variant-numeric: tabular-nums;
}
.astro-bar {
  margin-top: 14rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
}
.astro-bar-fill-sun {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 50%;
  background: linear-gradient(90deg, #FFB347 0%, #FF8C42 100%);
  border-radius: 6rpx;
}
.astro-bar-cap {
  position: absolute;
  top: -4rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #FF8C42;
  transform: translateX(-50%);
}
.astro-phase {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.6);
}
.astro-phase-icon { font-size: 32rpx; line-height: 1; }
.astro-phase-name {
  font-size: 24rpx;
  color: #4a4458;
  font-weight: 500;
}

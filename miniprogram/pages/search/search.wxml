<!-- pages/search/search.wxml - 城市搜索页 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="search-bar-inner" style="height: {{navBarHeight}}px; padding-right: {{navRight}}px;">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索城市名称"
          value="{{keyword}}"
          bindinput="onInput"
          bindconfirm="onSearch"
          focus="{{true}}"
          confirm-type="search"
        />
        <text class="search-clear" wx:if="{{keyword}}" bindtap="clearInput">✕</text>
      </view>
      <text class="search-cancel" bindtap="goBack">取消</text>
    </view>
  </view>

  <!-- 定位按钮 -->
  <view class="locate-btn" bindtap="locateCity">
    <text>📍 使用当前位置</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{results.length > 0}}">
    <view
      class="result-item flex-between"
      wx:for="{{results}}"
      wx:key="id"
      bindtap="selectCity"
      data-index="{{index}}"
    >
      <view>
        <text class="result-name">{{item.name}}</text>
        <text class="result-adm text-sm text-muted">{{item.adm1}} {{item.adm2}}</text>
      </view>
      <text class="result-country text-sm text-muted">{{item.country}}</text>
    </view>
  </view>

  <!-- 热门城市 -->
  <view class="hot-cities" wx:if="{{results.length === 0 && !searching}}">
    <view class="card-title">热门城市</view>
    <view class="hot-grid">
      <view
        class="hot-item"
        wx:for="{{hotCities}}"
        wx:key="id"
        bindtap="selectHotCity"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-lat="{{item.lat}}"
        data-lon="{{item.lon}}"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 加载/空状态 -->
  <view class="loading-wrap" wx:if="{{searching}}">
    <text>搜索中...</text>
  </view>
  <view class="empty-state" wx:if="{{!searching && results.length === 0 && keyword && keyword.length > 0}}">
    <text class="empty-text">未找到相关城市</text>
  </view>

</view>

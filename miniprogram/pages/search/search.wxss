/* pages/search/search.wxss */

.search-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.search-bar-inner {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.search-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 0 10rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #1677FF;
  padding-left: 20rpx;
}

.locate-btn {
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  color: #1677FF;
  font-size: 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* 搜索结果 */
.search-results {
  background: #FFFFFF;
}

.result-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.result-item:active {
  background: #F8F8F8;
}

.result-name {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
}

.result-adm {
  margin-top: 4rpx;
}

.result-country {
  color: #BBB;
}

/* 热门城市 */
.hot-cities {
  padding: 30rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hot-item {
  padding: 16rpx 30rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.hot-item:active {
  background: #E6F4FF;
  color: #1677FF;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

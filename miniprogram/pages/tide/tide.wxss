/* pages/tide/tide.wxss */

.tide-hero {
  background: linear-gradient(135deg, #0D4E8C 0%, #1677FF 50%, #4096FF 100%);
  padding: 30rpx 40rpx;
  color: #FFFFFF;
}

.tide-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.station-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.station-name {
  font-size: 30rpx;
  font-weight: 500;
}

.follow-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 6rpx 0 2rpx;
}

/* 海岸吸附提示：当前坐标无潮汐数据时自动吸附到最近海岸监测点 */
.snap-hint {
  font-size: 22rpx;
  color: #FFE58F;
  background: rgba(255, 169, 64, 0.15);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  margin-top: 8rpx;
}

/* 地点搜索 */
.tide-search {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.tide-search-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  color: #333;
}

.tide-search-cancel {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.tide-search-result {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 16rpx;
  overflow: hidden;
  max-height: 420rpx;
}

.tide-search-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.tide-search-item:last-child {
  border-bottom: none;
}

.tsi-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.tsi-adm {
  color: #999;
  margin-top: 4rpx;
}

.tide-search-empty {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 日期选择 */
.date-tabs {
  padding: 20rpx 30rpx;
  margin-top: -10rpx;
  position: relative;
  z-index: 1;
}

.date-scroll {
  white-space: nowrap;
}

.date-tab {
  display: inline-block;
  text-align: center;
  padding: 16rpx 30rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  background: #F5F7FA;
  transition: all 0.2s;
}

.date-tab-active {
  background: #1677FF;
  color: #FFFFFF;
}

.date-tab-day {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
}

.date-tab-active .date-tab-day {
  color: #FFFFFF;
}

.date-tab-date {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.date-tab-active .date-tab-date {
  color: rgba(255, 255, 255, 0.8);
}

/* 潮汐概览 */
.tide-summary {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.tide-summary-item {
  text-align: center;
  padding: 20rpx 30rpx;
  min-width: 150rpx;
}

.tide-type-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.tide-time {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.tide-height {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 潮汐图表 */
.tide-chart {
  display: flex;
  margin-top: 10rpx;
}

.chart-y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-right: 10rpx;
  padding-bottom: 30rpx;
}

.y-label {
  font-size: 22rpx;
  color: #999;
  line-height: 1;
}

.chart-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  overflow-x: auto;
  padding-bottom: 30rpx;
}

.chart-bar-wrap {
  flex: 1;
  min-width: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.chart-bar {
  width: 60%;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s;
}

/* 当前时间柱：橙色高亮 + 顶部“现在”圆点 + 轻微光晕 */
.chart-bar-wrap {
  position: relative;
}

.chart-bar-now .chart-bar {
  box-shadow: 0 0 12rpx rgba(250, 140, 22, 0.7);
}

.now-dot {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FA8C16;
  box-shadow: 0 0 8rpx rgba(250, 140, 22, 0.8);
}

.chart-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  writing-mode: horizontal-tb;
}

.chart-time-now {
  color: #FA8C16;
  font-weight: 700;
  font-size: 22rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  gap: 40rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.legend-high {
  background: #1677FF;
}

.legend-low {
  background: #91CAFF;
}

/* 小时列表 */
.hourly-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.hourly-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.hourly-item:last-child {
  border-bottom: none;
}

.hourly-time {
  width: 80rpx;
  font-size: 26rpx;
  color: #555;
}

.hourly-item-now {
  background: #FFF7E6;
  border-radius: 12rpx;
}

.hourly-time-now {
  color: #FA8C16;
  font-weight: 700;
}

.hourly-bar-wrap {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.hourly-bar {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.hourly-height {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  color: #BBB;
}

/* ============ 选点弹层（最近 + 按省份二级展开） ============ */
.station-picker {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
}

.sp-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.sp-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 78vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.sp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.sp-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.sp-search {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.sp-search-input {
  flex: 1;
  background: #F5F7FA;
  border-radius: 30rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: #333;
}

.sp-search-cancel {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #1677FF;
}

.sp-search-result {
  margin-top: 12rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  overflow: hidden;
  max-height: 300rpx;
}

.sp-search-empty {
  margin-top: 16rpx;
  color: #999;
}

.sp-scroll {
  margin-top: 16rpx;
  flex: 1;
  min-height: 0;      /* 关键：flex 纵向子项默认 min-height:auto 不收缩，导致 scroll-y 不生效、内容被裁切 */
  overflow: hidden;
  padding-right: 44rpx;   /* 给右侧快速索引竖栏留出空间，避免压住距离/箭头 */
}

.sp-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #888;
  margin: 18rpx 0 10rpx;
}

.sp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.sp-item:active {
  background: #F5F7FA;
}

.sp-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.sp-item-sub {
  color: #999;
  margin-top: 4rpx;
}

.sp-item-dist {
  font-size: 26rpx;
  color: #1677FF;
}

.sp-prov {
  border-bottom: 1rpx solid #F0F0F0;
}

.sp-prov-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
}

.sp-prov-head:active {
  background: #F5F7FA;
}

.sp-prov-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.sp-prov-dist {
  font-size: 24rpx;
  color: #999;
  margin: 0 16rpx;
}

.sp-prov-arrow {
  font-size: 26rpx;
  color: #999;
}

.sp-prov-body {
  padding-bottom: 10rpx;
  background: #FAFBFC;
}

.sp-item-sub2 {
  padding-left: 32rpx;
}

/* 快速索引侧栏（右侧竖排） */
.sp-index {
  position: absolute;
  right: 6rpx;
  top: 170rpx;            /* 避开顶部标题与搜索框 */
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 5;
}

.sp-index-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: #1677FF;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
}

.sp-index-item:active,
.sp-index-active {
  background: #1677FF;
  color: #FFF;
}

/* pages/tide/tide.wxss */

/* 顶部沉浸式海岸点头部 */
.tide-hero {
  background: linear-gradient(135deg, #0A3A6B 0%, #1677FF 60%, #36CFC9 100%);
  padding: 24rpx 32rpx 28rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

/* 装饰性底层微光晕 */
.tide-hero::after {
  content: '';
  position: absolute;
  right: -50rpx;
  top: -50rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-station-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.station-main {
  flex: 1;
  min-width: 0;
}

.station-name-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.station-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}

.station-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  line-height: 1.2;
  backdrop-filter: blur(8px);
}

.chip-location {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.chip-custom {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.chip-snap {
  background: rgba(255, 214, 102, 0.22);
  color: #FFE58F;
  border: 1rpx solid rgba(255, 214, 102, 0.4);
}

.chip-icon {
  font-size: 20rpx;
}

/* 切换地点胶囊按钮 */
.switch-station-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  backdrop-filter: blur(8px);
  transition: all 0.2s ease;
}

.switch-station-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.96);
}

.switch-btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.switch-btn-arrow {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 2rpx;
}

/* 日期选择 */
.date-tabs {
  padding: 20rpx 30rpx;
  margin-top: -10rpx;
  position: relative;
  z-index: 1;
}

.date-scroll {
  white-space: nowrap;
}

.date-tab {
  display: inline-block;
  text-align: center;
  padding: 14rpx 20rpx;
  min-width: 136rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  margin-right: 14rpx;
  background: #F5F7FA;
  transition: all 0.2s;
  vertical-align: top;
}

.date-tab-active {
  background: #1677FF;
  color: #FFFFFF;
}

.date-tab-day {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.date-tab-active .date-tab-day {
  color: #FFFFFF;
}

.date-tab-date {
  display: block;
  font-size: 21rpx;
  color: #8C8C8C;
  margin-top: 2rpx;
}

.date-tab-active .date-tab-date {
  color: rgba(255, 255, 255, 0.82);
}

/* 日期滑块潮水等级与活汛/死汛微标 */
.date-tab-tide {
  margin-top: 8rpx;
  font-size: 19rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.tide-badge-sep {
  margin: 0 2rpx;
}

.tide-giant {
  background: #FFF0F6;
  color: #EB2F96;
  font-weight: 600;
}

.tide-big {
  background: #E6F4FF;
  color: #1677FF;
  font-weight: 600;
}

.tide-mid {
  background: #E6FFFB;
  color: #00A389;
  font-weight: 500;
}

.tide-small {
  background: #F0F0F0;
  color: #8C8C8C;
  font-weight: 500;
}

.date-tab-active .date-tab-tide {
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-weight: 600;
}

/* 潮汐概览（紧凑卡片） */
.tide-overview-card {
  padding: 20rpx 24rpx;
}

.overview-header {
  margin-bottom: 16rpx;
}

.overview-tip {
  font-size: 22rpx;
}

.tide-summary-grid {
  display: flex;
  gap: 14rpx;
}

.tide-summary-cell {
  flex: 1;
  min-width: 0;
  background: #F8FAFD;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(22, 119, 255, 0.08);
}

.cell-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
}

.cell-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.3;
}

.badge-high {
  background: #E6F4FF;
  color: #1677FF;
}

.badge-low {
  background: #E6FFFB;
  color: #00A389;
}

.cell-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #262626;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.cell-val {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
}

.cell-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #595959;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.cell-unit {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-left: 2rpx;
}

/* 潮汐曲线图表 */
.tide-chart {
  display: flex;
  margin-top: 14rpx;
  position: relative;
}

.chart-y-axis {
  width: 72rpx;
  height: 180px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 28px;
  padding-bottom: 26px;
  padding-right: 12rpx;
  flex-shrink: 0;
}

.y-label {
  font-size: 20rpx;
  color: #8C8C8C;
  line-height: 1;
}

.chart-area {
  flex: 1;
  height: 180px;
  overflow: hidden;
  white-space: nowrap;
}

.chart-inner {
  position: relative;
  height: 180px;
}

.tide-curve-img {
  display: block;
}

/* 离屏绘图缓冲画布 */
.canvas-buffer {
  position: absolute;
  left: -3000px;
  opacity: 0;
  pointer-events: none;
}

.chart-legend {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  gap: 36rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.legend-high {
  background: #1677FF;
}

.legend-low {
  background: #00A389;
}

.legend-now {
  background: #FA8C16;
}

/* 海洋实用指南 Tips */
.tips-card {
  padding: 24rpx;
}

.tips-tabs {
  display: flex;
  background: #F0F2F5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-top: 16rpx;
  margin-bottom: 20rpx;
  gap: 6rpx;
}

.tips-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: all 0.25s ease;
}

.tips-tab-icon {
  font-size: 26rpx;
}

.tips-tab-text {
  font-size: 24rpx;
  color: #595959;
  font-weight: 500;
}

.tips-tab-active {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.tips-tab-active .tips-tab-text {
  color: #1677FF;
  font-weight: 700;
}

.tips-content {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.tip-section {
  margin-bottom: 18rpx;
}

.tip-section-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #262626;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.tip-dot {
  color: #1677FF;
  font-size: 16rpx;
  margin-right: 10rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.tip-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.tag-orange {
  background: #FFF7E6;
  color: #FA8C16;
}

.tag-blue {
  background: #E6F4FF;
  color: #1677FF;
}

.tag-green {
  background: #F6FFED;
  color: #52C41A;
}

.tip-desc {
  font-size: 24rpx;
  color: #595959;
  flex: 1;
}

.tip-highlight {
  color: #FA8C16;
  font-weight: 600;
}

.tip-bold {
  color: #262626;
  font-weight: 600;
}

/* 安全警告警示框 */
.tip-warning-box {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 10rpx;
}

.warning-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #D46B08;
  margin-bottom: 6rpx;
}

.warning-desc {
  font-size: 22rpx;
  color: #873800;
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  color: #BBB;
}

/* ============ 选点弹层（最近 + 按省份二级展开） ============ */
.station-picker {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
}

.sp-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.sp-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 78vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.sp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.sp-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.sp-search {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.sp-search-input {
  flex: 1;
  background: #F5F7FA;
  border-radius: 30rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: #333;
}

.sp-search-cancel {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #1677FF;
}

.sp-search-result {
  margin-top: 12rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  overflow: hidden;
  max-height: 300rpx;
}

.sp-search-empty {
  margin-top: 16rpx;
  color: #999;
}

.sp-scroll {
  margin-top: 16rpx;
  flex: 1;
  min-height: 0;      /* 关键：flex 纵向子项默认 min-height:auto 不收缩，导致 scroll-y 不生效、内容被裁切 */
  overflow: hidden;
  padding-right: 44rpx;   /* 给右侧快速索引竖栏留出空间，避免压住距离/箭头 */
}

.sp-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #888;
  margin: 18rpx 0 10rpx;
}

.sp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.sp-item:active {
  background: #F5F7FA;
}

.sp-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.sp-item-sub {
  color: #999;
  margin-top: 4rpx;
}

.sp-item-dist {
  font-size: 26rpx;
  color: #1677FF;
}

.sp-prov {
  border-bottom: 1rpx solid #F0F0F0;
}

.sp-prov-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
}

.sp-prov-head:active {
  background: #F5F7FA;
}

.sp-prov-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.sp-prov-dist {
  font-size: 24rpx;
  color: #999;
  margin: 0 16rpx;
}

.sp-prov-arrow {
  font-size: 26rpx;
  color: #999;
}

.sp-prov-body {
  padding-bottom: 10rpx;
  background: #FAFBFC;
}

.sp-item-sub2 {
  padding-left: 32rpx;
}

/* 快速索引侧栏（右侧竖排） */
.sp-index {
  position: absolute;
  right: 6rpx;
  top: 170rpx;            /* 避开顶部标题与搜索框 */
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 5;
}

.sp-index-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: #1677FF;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
}

.sp-index-item:active,
.sp-index-active {
  background: #1677FF;
  color: #FFF;
}
